# Copy this file per customer, e.g. customers/acme.env, and fill in.
# Never commit real .env files with live tokens.

# The Dynatrace tenant this customer's demo run should send telemetry to.
# Different customers can point at different tenants (e.g. your own NFR
# tenant, or a partner's), or all share the same one — your choice.
DT_ENV_URL=https://abc12345.live.dynatrace.com

# API token with scopes: openTelemetryTrace.ingest, logs.ingest, bizevents.ingest
DT_API_TOKEN=dt0c01.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shown in every span name, log line, and business event (e.g. "OIC – Acme
# Corp Bill Generation Integration"). This is the only thing you need to
# change to re-skin the whole demo for a new customer.
CUSTOMER_NAME=Example Customer
